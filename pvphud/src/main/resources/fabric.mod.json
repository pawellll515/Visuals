{
  "schemaVersion": 1,
  "id": "pvphud",
  "version": "${version}",
  "name": "PvP HUD",
  "description": "Target HUD (itemy, zbroja, efekty), status HUD, własne hitboxy, marker na celu i własna tekstura ekwipunku. Tylko wizualne, client-side.",
  "authors": ["Ty"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["pl.pvphud.PvpHudClient"]
  },
  "mixins": [
    { "config": "pvphud.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
